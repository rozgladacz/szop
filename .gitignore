data/
!app/data/
*.db
*.db-journal
*.sqlite
*.sqlite3
*.bak

# Python
__pycache__/
app/routers/__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/

# Local tooling/bootstrap artifacts
.tools/
AIdeas/

# Durable runtime state generated by the roadmap coordinator
/.codex/runtime/

# A4 pipeline output (rules_extract / rules_drift / rules_classify_geometry)
build/

# D2 balance reports (scripts/balance_report.py — generowane artefakty)
reports/

# Documentation
# `dir/*` (not `dir/`) so per-file negations below still work — a blanket
# `dir/` pattern prunes the directory from traversal entirely, silently
# breaking `!file` exceptions (classic gitignore gotcha).
app/static/docs/*
# Hand-curated MD mirrors are engine SSOT (B0, faza-b) — must survive fresh
# checkouts for source_hashes.yaml / rules_sources_check.py to pass (decision
# 2026-07-08, rozwoj-faza-a-merge).
!app/static/docs/SZOP_Zdolnosci.md
!app/static/docs/SZOP_Rozjemca.md

# Scratch diff/audit dumps w root projektu (np. _b39_diff.txt, _drift_*.diff)
# — jednorazowe zrzuty z sesji, odtwarzalne z historii git. NIE dotyczy scripts/_*.py.
/_*.txt
/_*.diff
